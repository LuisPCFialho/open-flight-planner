{
  "name": "pye-flight-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Planeador de rotas de drone com saida KMZ para DJI Fly e DJI Pilot 2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:unidade": "vitest run --exclude \"**/*.integracao.test.ts\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dxf-parser": "^1.1.2",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.9.1",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
