{
  "name": "open-flight-planner",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Planeador de rotas de drone com saida KMZ para DJI Fly e DJI Pilot 2",
  "scripts": {
    "dev": "vite",
    "build": "oxlint && tsc --noEmit && vite build && node ferramentas/verificar-dist.ts",
    "preview": "vite preview",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:unidade": "vitest run --exclude \"**/*.integracao.test.ts\"",
    "test:watch": "vitest",
    "lint": "oxlint",
    "verificar-dist": "node ferramentas/verificar-dist.ts",
    "cobertura": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dxf-parser": "^1.1.2",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.9.1",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
