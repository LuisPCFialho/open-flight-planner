# Ligacao ao armazem remoto. Copiar para `.env.local` e preencher.
#
# Sem estas variaveis a aplicacao corre exactamente como sempre correu:
# projetos em IndexedDB, nesta maquina, sem conta nenhuma. E o que acontece a
# quem clona o repositorio, e e de proposito - `npm install && npm run dev` tem
# de chegar para trabalhar.
#
# Com elas, os projetos passam a viver numa conta e a segui-la de computador
# para computador. Como montar o projeto Firebase: docs/contas.md
#
# Ou estao todas, ou nao esta nenhuma: com metade, a aplicacao arranca em modo
# local em vez de arrancar meio ligada.
#
# Nenhum destes valores e um segredo. Vao no pacote que o browser transfere e
# qualquer pessoa os pode ler - e assim que o Firebase do lado do cliente
# funciona. O que protege os dados sao as regras em `firestore.rules`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
